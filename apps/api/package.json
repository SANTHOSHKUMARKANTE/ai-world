{
  "name": "@ai-world/api",
  "version": "0.0.0",
  "private": true,
  "description": "AI World API application",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "vitest run --exclude \"test/**/*.integration.spec.ts\" --exclude \"test/**/*.mailpit.spec.ts\"",
    "test:integration": "vitest run integration --exclude \"test/**/*.mailpit.spec.ts\"",
    "test:integration:mailpit": "vitest run test/email-verification-mailpit.mailpit.spec.ts test/password-recovery-mailpit.mailpit.spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@ai-world/foundation-configuration": "workspace:*",
    "@ai-world/foundation-database": "workspace:*",
    "@ai-world/foundation-email": "workspace:*",
    "@ai-world/foundation-errors": "workspace:*",
    "@ai-world/foundation-observability": "workspace:*",
    "@ai-world/platform-identity-access": "workspace:*",
    "@ai-world/platform-user": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.1.28",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "^9.5.2",
    "vitest": "4.1.10"
  }
}
