AI_WORLD_ENV=development
NODE_ENV=development
PORT=3001
# Public Web origin used to resolve canonical and Open Graph absolute URLs.
AI_WORLD_WEB_ORIGIN=http://127.0.0.1:3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://ai_world:ai_world@127.0.0.1:55432/ai_world
MEDIA_STORAGE_ROOT=./uploads

# Required to execute AI-assisted CMS suggestions through the OpenAI adapter.
# OPENAI_API_KEY=replace-with-a-runtime-secret

EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE=false
EMAIL_FROM=AI World <noreply@ai-world.local>
