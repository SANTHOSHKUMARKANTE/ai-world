{
  "name": "@ai-world/foundation-database",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL and Prisma database infrastructure for AI World",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:create": "prisma migrate dev --config prisma.migrate.config.ts --create-only",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.migrate.config.ts && pnpm run prisma:generate",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.migrate.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma.migrate.config.ts",
    "prisma:seed": "pnpm run prisma:generate && prisma db seed --config prisma.migrate.config.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"prisma/*.ts\" \"prisma.config.ts\" \"prisma.migrate.config.ts\" --ignore-pattern \"src/generated/**\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "prisma": "7.9.0",
    "tsx": "4.23.1"
  }
}
