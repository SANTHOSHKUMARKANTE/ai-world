{
  "name": "@ai-world/foundation-database",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL and Prisma database infrastructure for AI World",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "pnpm run prisma:generate && tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/generated/**\"",
    "typecheck": "pnpm run prisma:generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "prisma": "7.9.0"
  }
}
