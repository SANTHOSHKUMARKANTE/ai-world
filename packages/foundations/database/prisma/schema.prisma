generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Actor {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  email              ActorEmail?
  passwordCredential PasswordCredential?
  sessions           Session[]
  user               User?
  roleAssignments    ActorRole[]
  generations        Generation[]

  @@map("identity_actors")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @unique @map("actor_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  favorites   Favorite[]
  collections Collection[]

  @@map("users")
}

model ActorEmail {
  id              String    @id @default(uuid()) @db.Uuid
  actorId         String    @unique @map("actor_id") @db.Uuid
  email           String    @db.Text
  normalizedEmail String    @unique @map("normalized_email") @db.Text
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor                     Actor                       @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  verificationChallenge     EmailVerificationChallenge?
  passwordRecoveryChallenge PasswordRecoveryChallenge?

  @@map("identity_actor_emails")
}

model EmailVerificationChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  actorEmailId String    @unique @map("actor_email_id") @db.Uuid
  tokenDigest  String    @unique @map("token_digest") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  actorEmail ActorEmail @relation(fields: [actorEmailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@map("identity_email_verification_challenges")
}

model PasswordRecoveryChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  actorEmailId String    @unique @map("actor_email_id") @db.Uuid
  tokenDigest  String    @unique @map("token_digest") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  actorEmail ActorEmail @relation(fields: [actorEmailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@map("identity_password_recovery_challenges")
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @unique @map("actor_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("identity_password_credentials")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String    @map("actor_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([actorId])
  @@index([expiresAt])
  @@map("identity_sessions")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(64)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actorAssignments      ActorRole[]
  permissionAssignments RolePermission[]

  @@map("identity_roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(128)
  description String   @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments RolePermission[]

  @@map("identity_permissions")
}

model ActorRole {
  actorId    String   @map("actor_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([actorId, roleId])
  @@index([roleId])
  @@map("identity_actor_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("identity_role_permissions")
}

model AuditRecord {
  id           String   @id @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  action       String   @db.VarChar(128)
  resourceType String   @map("resource_type") @db.VarChar(128)
  resourceId   String   @map("resource_id") @db.Uuid
  result       String   @db.VarChar(128)
  context      Json?    @db.JsonB
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz(3)

  @@map("audit_records")
}

model KnowledgeResource {
  id           String   @id @db.Uuid
  universeKey  String   @map("universe_key") @db.VarChar(128)
  resourceType String   @map("resource_type") @db.VarChar(128)
  lifecycle    String   @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assetReferences         KnowledgeResourceAssetReference[]
  compositionPageItems    CompositionPageItem[]
  profile                 KnowledgeResourceProfile?
  outgoingEntityRelations KnowledgeResourceRelation[]       @relation("KnowledgeEntityRelationSource")
  incomingEntityRelations KnowledgeResourceRelation[]       @relation("KnowledgeEntityRelationTarget")

  @@map("knowledge_resources")
}

model KnowledgeResourceProfile {
  knowledgeResourceId String   @id @map("knowledge_resource_id") @db.Uuid
  routeKey            String   @unique @map("route_key") @db.VarChar(256)
  slug                String   @db.VarChar(96)
  displayName         String   @map("display_name") @db.VarChar(160)
  summary             String   @db.Text
  facts               Json     @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  knowledgeResource KnowledgeResource @relation(fields: [knowledgeResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([slug])
  @@map("knowledge_resource_profiles")
}

model KnowledgeResourceRelation {
  sourceResourceId String @map("source_resource_id") @db.Uuid
  targetResourceId String @map("target_resource_id") @db.Uuid
  sectionKey       String @map("section_key") @db.VarChar(128)
  relationshipType String @map("relationship_type") @db.VarChar(128)
  position         Int

  sourceResource KnowledgeResource @relation("KnowledgeEntityRelationSource", fields: [sourceResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetResource KnowledgeResource @relation("KnowledgeEntityRelationTarget", fields: [targetResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([sourceResourceId, relationshipType, targetResourceId])
  @@unique([sourceResourceId, sectionKey, position])
  @@index([targetResourceId])
  @@map("knowledge_resource_relations")
}

model Asset {
  id               String   @id @db.Uuid
  assetType        String   @map("asset_type") @db.VarChar(32)
  mimeType         String   @map("mime_type") @db.VarChar(255)
  sizeBytes        Int      @map("size_bytes")
  durationMs       Int?     @map("duration_ms")
  storageReference String   @map("storage_reference") @db.Text
  lifecycle        String   @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  knowledgeResourceReferences       KnowledgeResourceAssetReference[] @relation("KnowledgeResourceMediaAsset")
  knowledgeResourcePosterReferences KnowledgeResourceAssetReference[] @relation("KnowledgeResourceMediaPoster")
  compositionPageItems              CompositionPageItem[]

  @@map("media_assets")
}

model KnowledgeResourceAssetReference {
  knowledgeResourceId String  @map("knowledge_resource_id") @db.Uuid
  assetId             String  @map("asset_id") @db.Uuid
  role                String  @db.VarChar(32)
  playback            String  @db.VarChar(32)
  position            Int
  altText             String? @map("alt_text") @db.Text
  caption             String? @db.Text
  posterAssetId       String? @map("poster_asset_id") @db.Uuid

  knowledgeResource KnowledgeResource @relation(fields: [knowledgeResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset             Asset             @relation("KnowledgeResourceMediaAsset", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  posterAsset       Asset?            @relation("KnowledgeResourceMediaPoster", fields: [posterAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([knowledgeResourceId, assetId])
  @@unique([knowledgeResourceId, position])
  @@index([assetId])
  @@index([posterAssetId])
  @@map("knowledge_resource_asset_references")
}

model Generation {
  id        String   @id @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  status    String   @db.VarChar(32)
  provider  String   @db.VarChar(64)
  model     String?  @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor      Actor                 @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  request    GenerationRequest?
  result     GenerationResult?
  provenance GenerationProvenance?
  usage      GenerationUsage?

  @@index([actorId])
  @@map("ai_generations")
}

model GenerationRequest {
  generationId String   @id @map("generation_id") @db.Uuid
  input        String   @db.Text
  instructions String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("ai_generation_requests")
}

model GenerationResult {
  generationId String   @id @map("generation_id") @db.Uuid
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("ai_generation_results")
}

model GenerationProvenance {
  generationId  String   @id @map("generation_id") @db.Uuid
  task          String   @db.VarChar(128)
  sourceContext Json?    @map("source_context") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("ai_generation_provenance")
}

model GenerationUsage {
  generationId      String   @id @map("generation_id") @db.Uuid
  providerLatencyMs Int      @map("provider_latency_ms")
  inputTokens       Int?     @map("input_tokens")
  outputTokens      Int?     @map("output_tokens")
  totalTokens       Int?     @map("total_tokens")
  failureKind       String?  @map("failure_kind") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("ai_generation_usage")
}

model CompositionPage {
  id          String   @id @db.Uuid
  universeKey String   @map("universe_key") @db.VarChar(128)
  routePath   String   @map("route_path") @db.VarChar(512)
  title       String   @db.VarChar(160)
  lifecycle   String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  compositionItems CompositionPageItem[]

  @@unique([universeKey, routePath])
  @@map("composition_pages")
}

model CompositionBlock {
  id          String   @id @db.Uuid
  universeKey String   @map("universe_key") @db.VarChar(128)
  blockType   String   @map("block_type") @db.VarChar(128)
  textContent String   @map("text_content") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  compositionPageItems CompositionPageItem[]

  @@index([universeKey])
  @@map("composition_blocks")
}

model CompositionPageItem {
  pageId              String  @map("page_id") @db.Uuid
  position            Int
  itemKind            String  @map("item_kind") @db.VarChar(32)
  blockId             String? @map("block_id") @db.Uuid
  knowledgeResourceId String? @map("knowledge_resource_id") @db.Uuid
  assetId             String? @map("asset_id") @db.Uuid

  page              CompositionPage    @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  block             CompositionBlock?  @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  knowledgeResource KnowledgeResource? @relation(fields: [knowledgeResourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset             Asset?             @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([pageId, position])
  @@index([blockId])
  @@index([knowledgeResourceId])
  @@index([assetId])
  @@map("composition_page_items")
}

model Favorite {
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, resourceId])
  @@index([userId, createdAt])
  @@map("engagement_favorites")
}

model Collection {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships CollectionResource[]

  @@index([userId, createdAt])
  @@map("engagement_collections")
}

model CollectionResource {
  collectionId String   @map("collection_id") @db.Uuid
  resourceId   String   @map("resource_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([collectionId, resourceId])
  @@index([collectionId, addedAt])
  @@map("engagement_collection_resources")
}
