generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Actor {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  email              ActorEmail?
  passwordCredential PasswordCredential?
  sessions           Session[]
  user               User?

  @@map("identity_actors")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @unique @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("users")
}

model ActorEmail {
  id              String   @id @default(uuid()) @db.Uuid
  actorId         String   @unique @map("actor_id") @db.Uuid
  email           String   @db.Text
  normalizedEmail String   @unique @map("normalized_email") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("identity_actor_emails")
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @unique @map("actor_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("identity_password_credentials")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  actorId     String    @map("actor_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([actorId])
  @@index([expiresAt])
  @@map("identity_sessions")
}
