{
  "name": "@ai-world/kernel-audit",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical durable Audit Record semantics for AI World",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure.d.ts",
      "default": "./dist/infrastructure.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@ai-world/foundation-database": "workspace:*",
    "@ai-world/kernel-identifiers": "workspace:*",
    "@ai-world/kernel-namespace": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
