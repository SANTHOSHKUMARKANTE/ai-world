{
  "name": "@ai-world/platform-media",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical Media Asset ownership for AI World",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure.d.ts",
      "default": "./dist/infrastructure.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --exclude \"test/**/*.integration.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:integration": "vitest run integration"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ai-world/foundation-database": "workspace:*",
    "@ai-world/foundation-errors": "workspace:*",
    "@ai-world/foundation-storage": "workspace:*",
    "@ai-world/kernel-identifiers": "workspace:*",
    "@ai-world/kernel-namespace": "workspace:*",
    "@ai-world/platform-identity-access": "workspace:*",
    "sharp": "0.35.3"
  }
}
