{
  "name": "@ai-world/platform-user",
  "version": "0.0.0",
  "private": true,
  "description": "User profile ownership for AI World",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure.d.ts",
      "default": "./dist/infrastructure.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:integration": "vitest run integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ai-world/foundation-database": "workspace:*"
  }
}
