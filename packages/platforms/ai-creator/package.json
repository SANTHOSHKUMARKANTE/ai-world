{
  "name": "@ai-world/platform-ai-creator",
  "version": "0.0.0",
  "private": true,
  "description": "AI World-owned provider-neutral AI Provider Port",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure/openai": {
      "types": "./dist/infrastructure/openai/index.d.ts",
      "default": "./dist/infrastructure/openai/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --exclude \"test/**/*.integration.spec.ts\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:integration": "vitest run integration"
  },
  "devDependencies": {
    "@ai-world/foundation-database": "workspace:*",
    "@types/node": "24.13.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ai-world/kernel-identifiers": "workspace:*",
    "openai": "7.5.0"
  }
}
