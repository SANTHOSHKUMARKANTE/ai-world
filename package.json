{
  "name": "ai-world",
  "version": "0.0.0",
  "private": true,
  "description": "AI World platform monorepo",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/local-pnpm.mjs exec turbo run dev",
    "build": "turbo run build",
    "lint": "eslint \"scripts/**/*.mjs\" && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "turbo run test:e2e",
    "infra:local:up": "docker compose -f infrastructure/local/compose.yml up -d",
    "infra:local:stop": "docker compose -f infrastructure/local/compose.yml stop",
    "infra:local:down": "docker compose -f infrastructure/local/compose.yml down",
    "infra:local:status": "docker compose -f infrastructure/local/compose.yml ps",
    "infra:local:logs": "docker compose -f infrastructure/local/compose.yml logs -f postgres",
    "db:seed": "node scripts/local-pnpm.mjs --filter @ai-world/foundation-database run prisma:seed"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "24.18.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
